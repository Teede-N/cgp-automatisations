        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-5', max_tokens: 1200, temperature: 0, system: 'Résume ce RDV de gestion de patrimoine en JSON : objectifs, decisions, actions (avec échéance), points_vigilance. N\\'invente rien.', messages: [{ role: 'user', content: $json.body.transcription }] }) }}"
