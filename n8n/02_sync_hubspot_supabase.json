    {
      "parameters": {
        "jsCode": "// HubSpot -> table `clients` de l'app interne (supabase/schema.sql), téléphone normalisé\nconst tel = t => { const d = (t || '').replace(/\\D/g, '').replace(/^33/, '0');\n  return /^0[1-9]\\d{8}$/.test(d) ? `+33 ${d[1]} ${d.slice(2,4)} ${d.slice(4,6)} ${d.slice(6,8)} ${d.slice(8,10)}` : null; };\nreturn $input.all().map(i => { const p = i.json.properties ?? i.json; return { json: {\n  id: `HS-${i.json.id ?? p.hs_object_id}`, prenom: (p.firstname || '').trim(), nom: (p.lastname || '').trim(),\n  email: (p.email || '').trim().toLowerCase() || null, telephone: tel(p.phone),\n  date_kyc: p.date_kyc || null, conseiller: p.conseiller || 'Non attribué' } }; });"
      },
      "id": "f550a6b7-0379-592a-8f2f-e156ca8e15a7",
      "name": "Mapper vers le schéma app",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
